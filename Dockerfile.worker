FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY --chown=node:node scripts/render-summary.mjs ./scripts/render-summary.mjs
COPY --chown=node:node packages/media/render.mjs ./packages/media/render.mjs
USER node
CMD ["node","scripts/render-summary.mjs"]
