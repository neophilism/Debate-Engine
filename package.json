{
  "name": "public-debate-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "worker:deadlines": "node scripts/deadline-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/migrate.mjs --check",
    "test:db": "node --test tests/db.integration.mjs tests/privacy.db.integration.mjs tests/multimodal.db.integration.mjs tests/uploads.db.integration.mjs tests/policy-endorsement.db.integration.mjs",
    "worker:render": "node scripts/render-summary.mjs",
    "worker:render:once": "node scripts/render-summary.mjs --once"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "next": "16.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "pg": "^8.14.1",
    "@neondatabase/auth": "0.5.0-beta",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "@types/pg": "^8.11.10"
  }
}
